# Скопируйте в deploy/.env (make env) и поправьте значения. Файл deploy/.env в git не попадает.

# Пользователь PostgreSQL. Для локального стенда подойдёт любой, на сервере задайте свой.
POSTGRES_USER=orientir
# Пароль PostgreSQL. Здесь безопасно оставить пример только на своей машине; на сервере замените.
POSTGRES_PASSWORD=orientir
# Имя основной базы.
POSTGRES_DB=orientir

# Порт базы на хосте (только 127.0.0.1). Если 5432 занят другой базой, укажите свободный и поправьте
# TEST_DATABASE_URL.
DB_PORT=5432

# Строка подключения для api, worker и migrate. Хост db — имя сервиса в compose;
# для запуска команд с хоста замените на localhost.
DATABASE_URL=postgresql://orientir:orientir@db:5432/orientir
# Отдельная база для тестов: тесты пересоздают её схему, на основную не указывать.
TEST_DATABASE_URL=postgresql://orientir:orientir@localhost:5432/orientir_test

# Адрес OpenAI-совместимого API моделей (даёт организатор). Пусто — модели недоступны, сервис работает без них.
LLM_BASE_URL=
# Ключ API моделей. Пусто — безопасно: разборы собираются по шаблону без LLM. Ключ хранится только здесь.
LLM_API_KEY=
# Каталог Yandex Cloud для API моделей.
LLM_FOLDER_ID=
# Суточный потолок расходов на LLM в рублях; при превышении сервис переходит на разбор без модели.
# 0 — тратить нельзя: модель не вызывается вообще.
LLM_DAILY_BUDGET_RUB=480
# Потолок стоимости одного разбора, ₽.
INSIGHT_MAX_RUB=4
# Потолок стоимости одного ответа в чате, ₽.
CHAT_MAX_RUB=1.5

# 1 — все маршруты API отдают фикстуры, ни БД, ни модели не нужны (режим для интерфейса). 0 — боевой режим.
MOCK=0
# 1 — считать эмбеддинги (только если организаторы разрешили); 0 — поиск по лексике.
EMBED_ENABLED=0
# 1 — worker заранее строит разборы для верха лент; в день показа ставьте 0, чтобы сберечь бюджет.
WARM_ENABLED=1

# Время жизни сессии входа, часы.
SESSION_TTL_HOURS=12
# Пароль тестовых учёток, которые создаёт orientir seed. Для стенда замените на свой.
DEMO_PASSWORD=change-me
# Адрес веб-интерфейса, которому разрешены запросы к API (CORS). Для Vite — http://localhost:5173.
CORS_ORIGIN=http://localhost:5173

# Порт api на хосте.
API_PORT=8000
